{
  "name": "yarizan-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3200",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "lint": "eslint app server shared tests tools nuxt.config.ts playwright.config.ts vitest.config.ts --max-warnings=0",
    "format": "prettier --write app server shared tests tools *.ts *.json",
    "format:check": "prettier --check app server shared tests tools *.ts *.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts": "node tools/check-contracts.mjs --write",
    "contracts:check": "node tools/check-contracts.mjs",
    "audit:dependencies": "node tools/check-dependencies.mjs",
    "check:secrets": "node tools/check-secrets.mjs"
  },
  "dependencies": {
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "21.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13",
    "nuxt": "4.6.1"
  }
}
