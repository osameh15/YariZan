# Only disposable local data. Use independent random secrets, never this file as credentials.
NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://yarizan:local-disposable@127.0.0.1:55432/yarizan
BROWSER_ORIGIN=http://localhost:3200
# Generate at least 32 random bytes and encode as 64 hex characters.
CODE_HMAC_KEY=
TOKEN_HMAC_KEY=
MFA_ENCRYPTION_KEY=
# Synthetic development signing keys persist in ignored runtime storage; test keys are in memory.
# Production startup deliberately fails pending reviewed assurance/custody integration.

# SMS is disabled unless selected explicitly. Never send live SMS from CI.
SMS_PROVIDER=disabled
# Set independent random 32-byte hex keys when enabling fake or MeliPayamak.
MOBILE_ENCRYPTION_KEY=
OTP_HMAC_KEY=
SMS_ALLOW_LIVE=false
MELIPAYAMAK_API_TOKEN=
# Optional encrypted fake delivery fixture, development/test only; never an API mailbox.
# SMS_FAKE_OUTBOX=.local/sms-test-outbox.jsonl

# Synthetic local commerce only. Disabled is the normal release configuration.
COMMERCE_MODE=disabled
PURCHASE_SMS_TEMPLATE=purchase-confirmation-unconfigured

# Local sandbox integration (development only): COMMERCE_MODE=zarinpal_sandbox uses the OFFICIAL ZarinPal
# sandbox (sandbox.zarinpal.com), never the live service. Any random UUIDv4 is a valid sandbox merchant ID;
# never put a real merchant ID here. The callback must be https, or http on localhost, ending in /payment/return.
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_CALLBACK_URL=http://localhost:3200/payment/return
# Local acceptance test price for Grade 1 in integer IRR (for example 100000 = 10,000 Toman). It is refused
# outside development/test and is labelled as a test price everywhere. The official price is untouched.
# LOCAL_TEST_PRICE_G1_IRR=

