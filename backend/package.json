{
  "name": "yarizan-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "migrate": "node dist/src/database/migrate.js",
    "seed": "node dist/src/database/seed.js",
    "test": "node --test --test-concurrency=1 dist/test/*.test.js",
    "lint": "eslint src test tools --max-warnings=0",
    "format": "prettier --write src test tools package.json tsconfig.json",
    "format:check": "prettier --check src test tools package.json tsconfig.json",
    "check:contracts": "node tools/check-contracts.mjs",
    "check:secrets": "node tools/check-secrets.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
