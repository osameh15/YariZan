<UserControl x:Class="YariZan.App.Views.InfoPage"
             NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="fa-IR" NumberSubstitution.Substitution="NativeNational"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{DynamicResource ShabnamFont}"
             Background="Transparent">

    <Viewbox Stretch="Uniform">
        <Grid Width="1100" Height="680">

            <Border CornerRadius="14" BorderBrush="{StaticResource LeatherDarkBrush}"
                    BorderThickness="3" Background="{StaticResource LeatherCoverBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" Opacity="0.6" ShadowDepth="6" />
                </Border.Effect>
            </Border>

            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource ParchmentBrushGradient}" CornerRadius="6"
                        Margin="6,4,0,4">
                    <Grid Margin="40">
                        <StackPanel VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/YariZan;component/Resources/logo.png"
                                   Width="260" Height="260" Stretch="Uniform" />
                            <TextBlock x:Name="AppTitle" FontFamily="{DynamicResource ShabnamBoldFont}"
                                       FontSize="24" Foreground="{StaticResource LeatherDarkBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="مجموعه بازی‌های آموزشی" FontSize="20"
                                       Foreground="{StaticResource LeatherBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Width="6" Fill="{StaticResource LeatherDarkBrush}"
                           HorizontalAlignment="Center" Margin="0,4" />

                <Border Grid.Column="1" Background="{StaticResource ParchmentBrushGradient}" CornerRadius="6"
                        Margin="0,4,6,4">
                    <Grid Margin="40,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="درباره" FontFamily="{DynamicResource ShabnamBoldFont}"
                                       FontSize="32" Foreground="{StaticResource LeatherDarkBrush}"
                                       HorizontalAlignment="Center" />

                            <TextBlock FontSize="18" Foreground="{StaticResource InkBrush}"
                                       TextAlignment="Justify" TextWrapping="Wrap" Margin="0,16,0,0"
                                       LineHeight="29">
                                <Run x:Name="IntroductionText" />
                            </TextBlock>

                            <Border Margin="0,16,0,0" Padding="18,10" CornerRadius="6"
                                    Background="#22000000" BorderBrush="{StaticResource LeatherBrush}" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="پدیدآورنده" FontFamily="{DynamicResource ShabnamBoldFont}"
                                               FontSize="18" Foreground="{StaticResource LeatherDarkBrush}" />
                                    <TextBlock Text="OAR NOVA GAMES STUDIO" FontSize="16" FlowDirection="RightToLeft" Language="en-US" FontFamily="Segoe UI"
                                               Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                                    <TextBlock x:Name="VersionText" FontSize="14"
                                               Foreground="{StaticResource LeatherBrush}" Margin="0,8,0,0" />
                                    <!-- The device username stays visible after activation: support and a second
                                         profile on the same PC need it, and the activation screen is no longer shown. -->
                                    <StackPanel x:Name="IdentityPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                        <TextBlock x:Name="IdentityLabel" Text="شناسه کاربری شما" FontSize="14"
                                                   FontFamily="{DynamicResource ShabnamBoldFont}"
                                                   Foreground="{StaticResource LeatherDarkBrush}" />
                                        <DockPanel FlowDirection="LeftToRight" Margin="0,4,0,0">
                                            <Button x:Name="CopyIdentityButton" Content="کپی" DockPanel.Dock="Right"
                                                    Style="{StaticResource GoldButton}" FontSize="14" Padding="12,5"
                                                    FlowDirection="RightToLeft"
                                                    Click="CopyIdentity_Click" AutomationProperties.Name="کپی شناسه کاربری" />
                                            <TextBox x:Name="IdentityText" IsReadOnly="True" BorderThickness="0"
                                                     Background="Transparent" NumberSubstitution.Substitution="European"
                                                     Language="en-US" FontFamily="Consolas, Tahoma" FontSize="14"
                                                     FlowDirection="LeftToRight" VerticalContentAlignment="Center"
                                                     Foreground="{StaticResource InkBrush}"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=IdentityLabel}" />
                                        </DockPanel>
                                        <TextBlock x:Name="IdentityFeedback" FontSize="13" Margin="0,4,0,0" Visibility="Collapsed"
                                                   Foreground="{StaticResource LeatherBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TrialBanner" Visibility="Collapsed"
                                               FontFamily="{DynamicResource ShabnamBoldFont}" FontSize="14"
                                               Foreground="#A3501F" TextAlignment="Center"
                                               Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel HorizontalAlignment="Stretch" Margin="0,16,0,0">
                                <Button Content="ورود به کتاب بازی‌ها" Style="{StaticResource GoldButton}"
                                        HorizontalAlignment="Stretch" Click="Next_Click" Margin="0,0,0,10" />
                                <!-- RTL Grid: column 0 renders on the visual RIGHT.
                                     Visual layout (right→left): minimize | خروج | بازگشت. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="بازگشت" Style="{StaticResource GoldButton}"
                                            HorizontalAlignment="Stretch" Click="Back_Click" />
                                    <Button Grid.Column="2" Style="{StaticResource MinimizeButton}"
                                            Click="Minimize_Click" />
                                    <Button Grid.Column="4" Content="خروج" Style="{StaticResource ExitButton}"
                                            HorizontalAlignment="Stretch" Click="Exit_Click" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
