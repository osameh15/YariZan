<UserControl x:Class="YariZan.App.Views.GamesBookPage"
             NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="fa-IR" NumberSubstitution.Substitution="NativeNational"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{DynamicResource ShabnamFont}"
             Background="Transparent" PreviewKeyDown="Modal_KeyDown">
    <UserControl.Resources>

        <Style x:Key="GameTile" TargetType="Button">
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource ShabnamBoldFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource LeatherDarkBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" BorderBrush="{StaticResource LeatherBrush}"
                                BorderThickness="1.5" Background="#FBEFCB" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF6D8" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoBadge" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Georgia, Tahoma" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring" Fill="{StaticResource LeatherBrush}"
                                     Stroke="{StaticResource GoldBrush}" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="6" Opacity="0.4" ShadowDepth="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="i" FlowDirection="LeftToRight" FontFamily="Georgia"
                                       FontStyle="Italic" FontWeight="Bold" FontSize="20"
                                       Foreground="{StaticResource GoldBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-2,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{StaticResource LeatherDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1200" Height="740">

            <Border CornerRadius="14" BorderBrush="{StaticResource LeatherDarkBrush}"
                    BorderThickness="3" Background="{StaticResource LeatherCoverBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" Opacity="0.6" ShadowDepth="6" />
                </Border.Effect>
            </Border>

            <Grid x:Name="BookContent" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,2,6,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="GradeTitle" FontFamily="{DynamicResource ShabnamBoldFont}"
                               FontSize="22" Foreground="{StaticResource GoldBrush}"
                               VerticalAlignment="Center" Margin="8,0" />




                    <Image x:Name="HeaderLogo" Grid.Column="1" Width="110" Height="70" Margin="12,0"
                           Source="pack://application:,,,/YariZan;component/Resources/YariZan_Symbol_Only_256x256.png"
                           Stretch="Uniform" FlowDirection="LeftToRight" HorizontalAlignment="Center"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="یاریزان" />

                    <!-- RTL StackPanel: minimize before خروج in source = minimize visually right of خروج. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Width="44" Height="44" Padding="3" Margin="4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="Contact_Click" ToolTip="ارتباط با ما" AutomationProperties.Name="ارتباط با ما">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Image Source="/YariZan;component/Resources/YariZan_Contact_Icon_128x128.png"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Button>
                        <Button Content="درباره" Style="{StaticResource GoldButton}" FontSize="14" MinHeight="36" Padding="14,6" Click="About_Click" Margin="4,0" ToolTip="دربارهٔ مجموعهٔ آموزشی" />
                        <Button Content="بازگشت" Style="{StaticResource GoldButton}"
                                FontSize="14" MinHeight="36" Padding="14,6"
                                Click="Back_Click" Margin="4,0" />
                        <Button Style="{StaticResource MinimizeButton}"
                                Click="Minimize_Click" Margin="4,0" />
                        <Button Content="خروج" Style="{StaticResource ExitButton}"
                                FontSize="14" MinHeight="36" Padding="14,6"
                                Click="Exit_Click" Margin="4,0" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" x:Name="SpreadHost" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Grid.Column=0 lands on the RIGHT under FlowDirection=RTL (first page in a Persian book). -->
                    <Border Grid.Column="0" Background="{StaticResource ParchmentBrushGradient}"
                            CornerRadius="6" Margin="6,0,0,0">
                        <UniformGrid x:Name="RightSide" Rows="2" Columns="3" Margin="14" />
                    </Border>

                    <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Width="6"
                               Fill="{StaticResource LeatherDarkBrush}" HorizontalAlignment="Center" />

                    <Border Grid.Column="1" Background="{StaticResource ParchmentBrushGradient}"
                            CornerRadius="6" Margin="0,0,6,0">
                        <UniformGrid x:Name="LeftSide" Rows="2" Columns="3" Margin="14" />
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="6,10,6,2">
                    <!-- RTL book: Previous lives on the visual RIGHT (where you came from),
                         Next lives on the visual LEFT (where you're heading). -->
                    <Button x:Name="PreviousButton" Content="صفحهٔ قبل" Style="{StaticResource GoldButton}"
                            FontSize="14" MinHeight="36" Padding="18,6"
                            HorizontalAlignment="Left" Click="PrevPage_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="صفحهٔ" FontSize="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox x:Name="PageNumber" Width="54" MaxLength="6" FontSize="16" TextAlignment="Center"
                                 FontFamily="{DynamicResource ShabnamFont}"
                                 VerticalContentAlignment="Center" Padding="4" FlowDirection="LeftToRight"
                                 ToolTip="شمارهٔ صفحه را وارد کنید و Enter بزنید" KeyDown="PageNumber_KeyDown"
                                 AutomationProperties.Name="شمارهٔ صفحه" />
                        <TextBlock x:Name="PageTotal" FontSize="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="8,0" />
                        <Button x:Name="JumpButton" Content="برو" Style="{StaticResource GoldButton}" FontSize="14"
                                MinHeight="36" Padding="12,6" Click="Jump_Click" />
                    </StackPanel>
                    <Button x:Name="NextButton" Content="صفحهٔ بعد" Style="{StaticResource GoldButton}"
                            FontSize="14" MinHeight="36" Padding="18,6"
                            HorizontalAlignment="Right" Click="NextPage_Click" />
                </Grid>
            </Grid>

            <!-- Modal info overlay -->
            <Grid x:Name="InfoOverlay" Visibility="Collapsed" Background="#D9160A04"
                  MouseLeftButtonDown="Overlay_BackgroundClick" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <Border MaxWidth="640" Margin="40" Style="{StaticResource BookModalCard}"
                        MouseLeftButtonDown="Overlay_PanelClick">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="40" Opacity="0.7" ShadowDepth="0" />
                    </Border.Effect>
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="InfoTitle" FontFamily="{DynamicResource ShabnamBoldFont}"
                                   FontSize="26" Foreground="{StaticResource LeatherDarkBrush}"
                                   TextAlignment="Center" />

                        <Border Grid.Row="1" Margin="0,12,0,0" Height="2" Background="{StaticResource GoldBrush}" Opacity="0.5" />

                        <ScrollViewer x:Name="InfoScroll" Grid.Row="2" MaxHeight="320" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Margin="0,16,0,0">
                            <TextBlock x:Name="InfoBody" FontSize="18" Foreground="{StaticResource InkBrush}"
                                       TextWrapping="Wrap" TextAlignment="Justify" LineHeight="32" />
                        </ScrollViewer>

                        <ScrollViewer x:Name="GameChoiceScroll" Grid.Row="2" Visibility="Collapsed" MaxHeight="320"
                                      VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" MinWidth="360">
                            <StackPanel x:Name="GameChoices" />
                        </ScrollViewer>

                        <StackPanel x:Name="ContactPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,16,0,0" MinWidth="420">
                            <Button Style="{StaticResource GoldButton}" HorizontalContentAlignment="Stretch" Click="StudioWebsite_Click" Margin="0,0,0,12" Padding="16,12"
                                    AutomationProperties.Name="وب‌سایت استودیو OAR NOVA Games">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <Image Grid.Column="1" Source="/YariZan;component/Resources/OAR_Nova_Game.png" Width="64" Height="64" Stretch="Uniform" Margin="16,0,0,0" />
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="استودیو OAR NOVA Games" FontSize="18" FlowDirection="LeftToRight" TextAlignment="Right" />
                                        <TextBlock Text="oarnova.games" FontSize="16" FlowDirection="LeftToRight" TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource GoldButton}" HorizontalContentAlignment="Stretch" Click="YarizanWebsite_Click" Padding="16,12"
                                    AutomationProperties.Name="وب‌سایت یاریزان">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <Image Grid.Column="1" Source="/YariZan;component/Resources/YariZan_Symbol_Only_256x256.png" Width="64" Height="64" Stretch="Uniform" Margin="16,0,0,0" />
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="یاریزان" FontSize="18" FlowDirection="LeftToRight" TextAlignment="Right" />
                                        <TextBlock Text="yarizan.oarnova.games" FontSize="16" FlowDirection="LeftToRight" TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <TextBlock x:Name="ContactFeedback" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,0"
                                       Foreground="{StaticResource InkBrush}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button x:Name="InfoLaunchButton" Content="اجرا" Style="{StaticResource GoldButton}" MinWidth="140"
                                    Click="InfoLaunch_Click" Margin="6,0" />
                            <Button x:Name="InfoCloseButton" Content="بستن" Style="{StaticResource ExitButton}" MinWidth="100"
                                    Click="InfoClose_Click" Margin="6,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
