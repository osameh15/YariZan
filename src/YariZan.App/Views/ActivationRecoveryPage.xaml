<UserControl x:Class="YariZan.App.Views.ActivationRecoveryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{DynamicResource ShabnamFont}">
    <Grid>
        <Border x:Name="RecoveryCard" MaxWidth="520" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                CornerRadius="14" BorderBrush="{StaticResource LeatherDarkBrush}" BorderThickness="3"
                Background="{StaticResource ParchmentBrushGradient}" Padding="28,24"
                AutomationProperties.Name="بررسی مجوز خرید">
            <StackPanel>
                <Image Source="pack://application:,,,/YariZan;component/Resources/YariZan_Symbol_Only_256x256.png"
                       Width="54" Height="54" Stretch="Uniform" Margin="0,0,0,10" AutomationProperties.Name="یاریزان" />
                <TextBlock x:Name="RecoveryTitle" Text="در حال بررسی مجوز خرید…" FontFamily="{DynamicResource ShabnamBoldFont}"
                           FontSize="22" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource LeatherDarkBrush}"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="RecoveryProgress" Height="6" Margin="12,16,12,12" Minimum="0" Maximum="100" Value="40"
                             FlowDirection="LeftToRight" Foreground="{StaticResource GoldBrush}" Background="#33582E1B"
                             AutomationProperties.Name="پیشرفت بررسی مجوز">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid ClipToBounds="True">
                                <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                                <Border x:Name="Runner" Width="120" CornerRadius="3" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00C9A45C" Offset="0" />
                                            <GradientStop Color="#FFC9A45C" Offset="0.5" />
                                            <GradientStop Color="#00C9A45C" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform><TranslateTransform X="-120" /></Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="RunnerMotion">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Runner"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="-120" To="520" Duration="0:0:1.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions><StopStoryboard BeginStoryboardName="RunnerMotion" /></Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock x:Name="RecoveryDetail" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource InkBrush}"
                           Text="خرید قبلی شما به‌صورت امن بررسی می‌شود. این کار چند ثانیه طول می‌کشد." />
                <Button x:Name="SkipButton" Content="نمایش گزینه‌ها" Style="{StaticResource GoldButton}" FontSize="14"
                        Padding="14,7" Margin="0,16,0,0" HorizontalAlignment="Center" Click="Skip_Click"
                        AutomationProperties.Name="توقف بررسی و نمایش گزینه‌های فعال‌سازی" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
