<UserControl x:Class="YariZan.App.Views.GameLoadingOverlay"
             NumberSubstitution.CultureSource="Override" NumberSubstitution.CultureOverride="fa-IR" NumberSubstitution.Substitution="NativeNational"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{DynamicResource ShabnamFont}"
             Background="#D9160A04" IsVisibleChanged="VisibilityChanged">
    <Border Width="440" Padding="32" Style="{StaticResource BookModalCard}">
        <StackPanel>
            <Image x:Name="LoadingLogo" Source="pack://application:,,,/YariZan;component/Resources/logo.png"
                   Width="170" Height="195" Stretch="Uniform" FlowDirection="LeftToRight"
                   HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="در حال آماده‌سازی بازی…" FontSize="22"
                       FontFamily="{DynamicResource ShabnamBoldFont}"
                       Foreground="{StaticResource LeatherDarkBrush}" TextAlignment="Center" Margin="0,20,0,0" />
            <TextBlock x:Name="LoadingGameName" FontSize="16" Foreground="{StaticResource InkBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
            <ProgressBar Height="5" Width="230" Margin="0,22,0,0" IsIndeterminate="True"
                         Foreground="{StaticResource GoldBrush}" Background="#305C2E1B" BorderThickness="0"
                         AutomationProperties.Name="در حال آماده‌سازی بازی" />
            <TextBlock Text="لطفاً کمی صبر کنید" FontSize="14" Foreground="{StaticResource LeatherBrush}"
                       TextAlignment="Center" Margin="0,14,0,0" />
        </StackPanel>
    </Border>
</UserControl>
