             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#160A04" AutomationProperties.Name="OAR NOVA Games">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <Image Source="pack://application:,,,/YariZan;component/Resources/OAR_Nova_Game.png"
                   Width="220" Height="200" Stretch="Uniform" />
