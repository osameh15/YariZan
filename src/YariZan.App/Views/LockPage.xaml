<UserControl x:Class="YariZan.App.Views.LockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="{DynamicResource ShabnamFont}" SizeChanged="Page_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="DialogFeedback" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource GoldButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="WarmCodeInput" TargetType="TextBox">
            <Setter Property="Background" Value="#FAEFCF" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LeatherBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="{StaticResource GoldBrush}" />
            <Setter Property="SelectionOpacity" Value="0.4" />
            <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid PreviewKeyDown="Page_PreviewKeyDown" PreviewMouseWheel="Page_PreviewMouseWheel">
    <ScrollViewer x:Name="LockScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                  Padding="12" CanContentScroll="False" PanningMode="VerticalOnly" IsManipulationEnabled="True">
        <Border x:Name="ActivationCard" MaxWidth="740" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                CornerRadius="14" BorderBrush="{StaticResource LeatherDarkBrush}" BorderThickness="3"
                Background="{StaticResource ParchmentBrushGradient}" Padding="24,22">
            <StackPanel>
                <Image Source="pack://application:,,,/YariZan;component/Resources/YariZan_Symbol_Only_256x256.png"
                       Width="54" Height="54" Stretch="Uniform" Margin="0,0,0,8" AutomationProperties.Name="یاریزان" />
                <TextBlock x:Name="ActivationTitle" FontFamily="{DynamicResource ShabnamBoldFont}" FontSize="26"
                           Foreground="{StaticResource LeatherDarkBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock Text="برای شروع، نسخه خود را فعال کنید یا آن را رایگان امتحان کنید."
                           FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,16"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock x:Name="IdentityLabel" Text="شناسه کاربری شما" FontFamily="{DynamicResource ShabnamBoldFont}"
                           FontSize="15" Foreground="{StaticResource LeatherDarkBrush}" Margin="0,0,0,6" />
                <Border Background="#FAEFCF" BorderBrush="{StaticResource LeatherBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="8">
                    <DockPanel FlowDirection="LeftToRight">
                        <Button x:Name="CopyHwidBtn" Content="کپی" DockPanel.Dock="Right" Style="{StaticResource SecondaryAction}"
                                Click="CopyHwid_Click" FlowDirection="RightToLeft" AutomationProperties.Name="کپی شناسه کاربری" />
                        <TextBox x:Name="HwidText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas, Tahoma" FontSize="15" FlowDirection="LeftToRight" TextWrapping="Wrap"
                                 VerticalContentAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=IdentityLabel}" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="TrialCountText" FontSize="16" Foreground="{StaticResource LeatherDarkBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,8" />
                <UniformGrid x:Name="PrimaryActions" Columns="2">
                    <Button x:Name="TrialButton" Content="ورود آزمایشی" Style="{StaticResource GoldButton}"
                            FontSize="17" Padding="8,12" Margin="4" Click="Trial_Click" />
                    <Button x:Name="ActivateButton" Content="فعال‌سازی نسخه" Style="{StaticResource GoldButton}"
                            FontSize="17" Padding="8,12" Margin="4" Click="Activate_Click" />
                </UniformGrid>
                <TextBlock Text="پس از فعال‌سازی یا شروع آزمایش، برای ادامه بازی به اینترنت نیاز ندارید."
                           Foreground="{StaticResource InkBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,4" />
                <Border x:Name="StatusPanel" Visibility="Collapsed" CornerRadius="6" Padding="12,8" Margin="0,10,0,4">
                    <TextBlock x:Name="StatusText" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                </Border>
                <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="ManualCodeButton" Content="کد فعال‌سازی دارید؟" Style="{StaticResource SecondaryAction}" Click="ManualCode_Click" />
                    <Button x:Name="PurchaseButton" Content="راهنمای خرید" Style="{StaticResource SecondaryAction}" Click="Purchase_Click" />
                    <Button x:Name="SupportButton" Content="پشتیبانی" Style="{StaticResource SecondaryAction}" Click="Support_Click" />
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="بازگشت" Style="{StaticResource SecondaryAction}" Click="Cancel_Click" />
                    <Button Style="{StaticResource MinimizeButton}" Click="Minimize_Click" Margin="4" />
                    <Button Content="خروج" Style="{StaticResource ExitButton}" Click="Exit_Click" Margin="4" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
    <Grid x:Name="ModalOverlay" Visibility="Collapsed" Background="#B8000000"
          AutomationProperties.Name="{Binding ElementName=ModalTitle, Path=Text}"
          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
          FocusManager.IsFocusScope="True" RequestBringIntoView="Modal_RequestBringIntoView">
        <Border x:Name="ModalCard" MaxWidth="600" Margin="16" Padding="20" CornerRadius="12"
                HorizontalAlignment="Stretch" VerticalAlignment="Center" BorderThickness="2"
                BorderBrush="{StaticResource GoldBrush}" Background="{StaticResource ParchmentBrushGradient}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="ModalTitle" FontFamily="{DynamicResource ShabnamBoldFont}" FontSize="22"
                           Foreground="{StaticResource LeatherDarkBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <ScrollViewer x:Name="ModalScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="VerticalOnly" IsManipulationEnabled="True" Focusable="False">
                    <StackPanel>
                        <TextBlock x:Name="ModalDescription" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" Margin="0,0,0,12" />
                        <Border x:Name="ManualCodePanel" Visibility="Collapsed">
                            <StackPanel>
                                <Label x:Name="CodeLabel" Content="کد فعال‌سازی" Target="{Binding ElementName=ActivationCodeInput}" FontSize="15" Padding="0,0,0,6" />
                                <TextBox x:Name="ActivationCodeInput" Style="{StaticResource WarmCodeInput}" MaxLength="64"
                                         FontSize="16" FontFamily="Consolas, Tahoma" FlowDirection="LeftToRight" Padding="10"
                                         TextWrapping="Wrap" MinHeight="44" KeyboardNavigation.TabIndex="0"
                                         AutomationProperties.LabeledBy="{Binding ElementName=CodeLabel}" TextChanged="Code_TextChanged" />
                                <TextBlock x:Name="CodeFeedback" Foreground="#8B0000" Style="{StaticResource DialogFeedback}"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="RedeemButton" Content="ثبت کد و فعال‌سازی" Style="{StaticResource GoldButton}"
                                        FontSize="16" Padding="12,10" Margin="0,12,0,4" Click="Redeem_Click" KeyboardNavigation.TabIndex="1" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="ContactPanel" Visibility="Collapsed">
                            <TextBlock Text="شماره پشتیبانی" FontSize="14" Foreground="{StaticResource LeatherDarkBrush}" />
                            <TextBlock x:Name="PhoneText" Text="0918-876-4024" FontFamily="Consolas, Tahoma" FontSize="22"
                                       FlowDirection="LeftToRight" TextAlignment="Center" Margin="0,8,0,12" />
                            <TextBlock x:Name="PreparedMessageText" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" Margin="0,0,0,12" />
                            <WrapPanel HorizontalAlignment="Center">
                                <Button x:Name="CopyPhoneButton" Content="کپی شماره" Style="{StaticResource SecondaryAction}" Click="CopyPhone_Click"
                                        AutomationProperties.Name="کپی شماره پشتیبانی" KeyboardNavigation.TabIndex="0" />
                                <Button x:Name="CopyPreparedButton" Content="کپی پیام آماده" Style="{StaticResource SecondaryAction}" Click="CopyMessage_Click" KeyboardNavigation.TabIndex="1" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock x:Name="ModalFeedback" Style="{StaticResource DialogFeedback}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
                <Button x:Name="CloseModalButton" Grid.Row="2" Content="بستن" Style="{StaticResource SecondaryAction}"
                        HorizontalAlignment="Center" Margin="0,12,0,0" Click="CloseModal_Click" KeyboardNavigation.TabIndex="2"
                        AutomationProperties.Name="بستن پنجره" />
            </Grid>
        </Border>
    </Grid>
    </Grid>
</UserControl>
