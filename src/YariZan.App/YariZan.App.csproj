<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(LegacyWindows)' != 'true'">net9.0-windows</TargetFramework>
    <TargetFramework Condition="'$(LegacyWindows)' == 'true'">net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>YariZan</AssemblyName>
    <RootNamespace>YariZan.App</RootNamespace>
    <!-- Single source of the Windows release version. build-installer.bat passes it to Inno Setup,
         and tools/release/windows-version.test.mjs fails on any mismatch. -->
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>Copyright (C) 2026 OAR NOVA GAMES STUDIO</Copyright>
    <Company>OAR NOVA GAMES STUDIO</Company>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <GameBundleRoot Condition="'$(GameBundleRoot)' == ''">$(MSBuildThisFileDirectory)..\..\games_encrypted</GameBundleRoot>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\release\v2-store-destinations.json" Link="Config\v2-store-destinations.json" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(StandaloneProductSku)' != ''">
      <_Parameter1>YariZanStandaloneProduct</_Parameter1>
      <_Parameter2>$(StandaloneProductSku)</_Parameter2>
    </AssemblyAttribute>
    <!-- Release gate: reviewed V2 verification keys only; no signing private keys. -->
    <EmbeddedResource Include="..\..\secrets\v2-license-public-keys.json" Link="Keys\v2-license-public-keys.json"
                      Condition="Exists('..\..\secrets\v2-license-public-keys.json') and '$(LocalAcceptanceBuild)' != 'true'" />
    <!-- Local acceptance only: the disposable development root exported from the local stack
         (tools/local/Build-LocalAcceptanceApp.ps1). Its kid contains "development", which the
         commercial release check forbids. -->
    <EmbeddedResource Include="..\..\secrets\v2-local-acceptance-roots.json" Link="Keys\v2-license-public-keys.json"
                      Condition="'$(LocalAcceptanceBuild)' == 'true'" />
    <ProjectReference Include="..\YariZan.Core\YariZan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Conditional so CI can build without checking in real keys.
         If absent at compile time, the launcher will throw a clear error at activation. -->
    <EmbeddedResource Include="..\..\secrets\public.pem" Link="Keys\public.pem"
                      Condition="Exists('..\..\secrets\public.pem')" />
    <EmbeddedResource Include="..\..\secrets\master.key" Link="Keys\master.key"
                      Condition="Exists('..\..\secrets\master.key') and '$(IncludeGameKey)' != 'false'" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\Shabnam\*.ttf" />
    <Resource Include="Resources\Fonts\Shabnam\*.otf" />
    <Resource Include="Resources\icon.png" />
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\YariZan_Symbol_Only_256x256.png" />
    <Resource Include="Resources\OAR_Nova_Game.png" />
    <Resource Include="Resources\YariZan_Contact_Icon_128x128.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(GameBundleRoot)\**\*.*" Exclude="$(GameBundleRoot)\README.md" Link="games_encrypted\%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(IncludeGameBundle)' != 'false'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <!-- Ordinary builds are fixtures/review builds. Commercial builds and ordinary app publishes are gated. -->
  <Target Name="ValidateV2PublicRootInputs" BeforeTargets="PrepareForBuild"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\secrets\v2-license-public-keys.json') and '$(LocalAcceptanceBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\YariZan.ReleaseCheck\YariZan.ReleaseCheck.csproj&quot; -c Release -- --public-roots-only &quot;$(MSBuildThisFileDirectory)..\..\secrets\v2-license-public-keys.json&quot;" />
  </Target>
  <PropertyGroup Condition="'$(LocalAcceptanceBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);YARIZAN_LOCAL_ACCEPTANCE</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateLocalAcceptanceBuild" BeforeTargets="PrepareForBuild" Condition="'$(LocalAcceptanceBuild)' == 'true'">
    <Error Condition="'$(CommercialRelease)' == 'true'" Text="LocalAcceptanceBuild cannot be combined with CommercialRelease." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\secrets\v2-local-acceptance-roots.json')"
           Text="LocalAcceptanceBuild needs secrets/v2-local-acceptance-roots.json; run tools/local/Build-LocalAcceptanceApp.ps1." />
    <!-- No nested `dotnet run` of ReleaseCheck here: it rebuilds YariZan.Core into the shared output
         without this build's constants. The root is checked by the export script and, at runtime,
         by CommercialReleasePolicy.ReadPublicRoots (public SPKI only). -->
  </Target>
  <Target Name="ValidateV2CommercialBuild" BeforeTargets="PrepareForBuild" Condition="'$(CommercialRelease)' == 'true'">
    <Error Condition="'$(FixtureOnlyBuild)' == 'true'" Text="FixtureOnlyBuild cannot be combined with CommercialRelease." />
    <Error Condition="'$(LocalAcceptanceBuild)' == 'true'" Text="LocalAcceptanceBuild cannot be combined with CommercialRelease." />
    <Error Condition="'$(AcceptanceCandidate)' == 'true'" Text="AcceptanceCandidate cannot be combined with CommercialRelease." />
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\YariZan.ReleaseCheck\YariZan.ReleaseCheck.csproj&quot; -c Release -- --commercial &quot;$(MSBuildThisFileDirectory)..\..&quot;" />
  </Target>
  <!-- Physical acceptance candidate: production root and API, version 2.0.0-acceptance-candidate.
       It exists so W1-W14 can run before release approval and is never publishable. -->
  <PropertyGroup Condition="'$(AcceptanceCandidate)' == 'true'">
    <InformationalVersion>$(Version)-acceptance-candidate</InformationalVersion>
    <DefineConstants>$(DefineConstants);YARIZAN_ACCEPTANCE_CANDIDATE</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateAcceptanceCandidate" BeforeTargets="PrepareForBuild" Condition="'$(AcceptanceCandidate)' == 'true'">
    <Error Condition="'$(CommercialRelease)' == 'true'" Text="AcceptanceCandidate cannot be combined with CommercialRelease." />
    <Error Condition="'$(LocalAcceptanceBuild)' == 'true'" Text="AcceptanceCandidate cannot be combined with LocalAcceptanceBuild." />
    <Error Condition="'$(FixtureOnlyBuild)' == 'true'" Text="AcceptanceCandidate cannot be combined with FixtureOnlyBuild." />
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\YariZan.ReleaseCheck\YariZan.ReleaseCheck.csproj&quot; -c Release -- --acceptance-candidate &quot;$(MSBuildThisFileDirectory)..\..&quot;" />
  </Target>
  <Target Name="ValidateV2CommercialPublish" BeforeTargets="PrepareForPublish" Condition="'$(FixtureOnlyBuild)' != 'true' and '$(CommercialRelease)' != 'true' and '$(LocalAcceptanceBuild)' != 'true' and '$(AcceptanceCandidate)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\YariZan.ReleaseCheck\YariZan.ReleaseCheck.csproj&quot; -c Release -- --commercial &quot;$(MSBuildThisFileDirectory)..\..&quot;" />
  </Target>
  <ItemGroup Condition="'$(LegacyWindows)' == 'true'">
    <Reference Include="System.Net.Http" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <Compile Include="../YariZan.Core/Legacy/Aliases.cs" Link="Legacy/Aliases.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(LegacyWindows)' == 'true'">
    <AppConfig>Legacy.App.config</AppConfig>
    <InformationalVersion>$(Version)-legacy-acceptance-candidate</InformationalVersion>
  </PropertyGroup>
  <Target Name="ValidateLegacyBuild" BeforeTargets="ValidateV2PublicRootInputs;ValidateV2CommercialBuild;ValidateAcceptanceCandidate;PrepareForBuild" Condition="'$(LegacyWindows)' == 'true'">
    <Error Condition="'$(CommercialRelease)' == 'true'" Text="Legacy Windows has not passed Windows 7 SP1/8.1 acceptance; commercial release is disabled." />
    <Error Condition="'$(FixtureOnlyBuild)' != 'true' and '$(AcceptanceCandidate)' != 'true' and '$(LocalAcceptanceBuild)' != 'true'" Text="Legacy Windows builds must explicitly be fixtures or acceptance candidates until legacy OS acceptance is complete." />
  </Target>
</Project>
