<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(LegacyWindows)' != 'true'">net9.0-windows</TargetFramework>
    <TargetFramework Condition="'$(LegacyWindows)' == 'true'">net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>YariZan.Core</RootNamespace>
  </PropertyGroup>
  <!-- Workstation acceptance against the local stack only; never combined with CommercialRelease. -->
  <PropertyGroup Condition="'$(LocalAcceptanceBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);YARIZAN_LOCAL_ACCEPTANCE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(LegacyWindows)' != 'true'">
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(LegacyWindows)' == 'true'">
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" GeneratePathProperty="true" />
    <PackageReference Include="System.Text.Json" Version="10.0.14" GeneratePathProperty="true" />
    <PackageReference Include="System.Net.Http.Json" Version="10.0.14" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <None Include="$(PkgBouncyCastle_Cryptography)/LICENSE.md" Link="THIRD-PARTY/BouncyCastle-LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgSystem_Text_Json)/THIRD-PARTY-NOTICES.TXT" Link="THIRD-PARTY/DotNet-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Legacy/DotNet-LICENSE.txt" Link="THIRD-PARTY/DotNet-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
